{
  "name": "brave-talk-extension",
  "version": "3.0.5",
  "description": "Brave Talk extension",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node --experimental-transform-types --test src/tests/brave/**/*.test.ts",
    "test:e2e": "node --experimental-transform-types --test --test-concurrency=1 src/tests/google/**/*.test.ts src/tests/proton/**/*.test.ts",
    "test:e2e:google": "node --experimental-transform-types --test --test-concurrency=1 src/tests/google/**/*.test.ts",
    "test:e2e:proton": "node --experimental-transform-types --test --test-concurrency=1 src/tests/proton/**/*.test.ts",
    "test:all": "node --experimental-transform-types --test --test-concurrency=1 src/tests/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "webpack --mode production",
    "zip": "node scripts/create-zip.ts",
    "watch": "webpack --mode development --devtool inline-source-map --watch",
    "format": "prettier --write src/ scripts/",
    "format:check": "prettier --check src/ scripts/",
    "prepare": "husky install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brave/brave-talk-gcalendar-extension.git"
  },
  "bugs": {
    "url": "https://github.com/brave/brave-talk-gcalendar-extension/issues"
  },
  "homepage": "https://github.com/brave/brave-talk-gcalendar-extension#readme",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/chrome": "0.2.5",
    "@types/node": "25.9.5",
    "archiver": "8.0.0",
    "copy-webpack-plugin": "14.0.0",
    "dotenv": "17.4.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "puppeteer-core": "25.0.4",
    "ts-loader": "9.6.2",
    "typescript": "6.0.3",
    "webpack": "5.109.2",
    "webpack-cli": "7.0.3"
  },
  "lint-staged": {
    "src/*.ts": "prettier --write"
  }
}
